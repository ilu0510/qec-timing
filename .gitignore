# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
.venv-h2/

# Selene build artefacts (compiled emulator binaries / temp build dirs)
*.ll
*.bc

# Results: ignored by default, except the Stage 4a validation outputs, which
# are committed so nobody has to re-run them.
results/*
!results/.gitkeep
!results/stage4a/
results/stage4a/*
!results/stage4a/*.json
!results/stage4a/*.csv
!results/stage4a/*.png
!results/stage4a/*.log

# Full-circuit timing validation: preserve per-run scientific artifacts.
!results/stage5/
results/stage5/**
!results/stage5/**/
!results/stage5/**/*.json
!results/stage5/**/*.csv
!results/stage5/**/*.png
!results/stage5/**/*.log

# Source paper: the arXiv licence (arXiv.org perpetual non-exclusive 1.0) does
# not permit redistribution, so the PDF is not committed. See docs/paper/SOURCE.md.
docs/paper/*
!docs/paper/SOURCE.md

# Stage 6b Selene-vs-twin cross-check: preserve per-run artifacts.
!results/stage6b/
results/stage6b/**
!results/stage6b/**/
!results/stage6b/**/*.json
!results/stage6b/**/*.csv
!results/stage6b/**/*.log

# Stage 6c dt sweeps on the twin: preserve per-run artifacts.
!results/stage6c/
results/stage6c/**
!results/stage6c/**/
!results/stage6c/**/*.json
!results/stage6c/**/*.csv
!results/stage6c/**/*.log
!results/stage6c/**/*.png

# Stage 7a H2 feasibility: estimates, QIR scaling, and the small test QIR files.
!results/stage7a/
results/stage7a/**
!results/stage7a/**/
!results/stage7a/**/*.json
!results/stage7a/**/*.bc
!results/stage7a/**/*.ll
